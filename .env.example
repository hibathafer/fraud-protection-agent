# نسخة مثال آمنة — لا تحتوي أي مفاتيح حقيقية.
# الطريقة: انسخي هذا الملف باسم .env واملئي قيمك بيه.
#   copy .env.example .env
#
# القاعدة: ملف .env ما ينرفع لـ git أبداً (موجود بـ .gitignore).

# مفتاح Gemini API (من Google AI Studio) — بدونه المشروع يشتغل بالقوالب فقط
GEMINI_API_KEY=your-key-here

# اسم الموديل (الافتراضي: gemini-3.7-flash)
GEMINI_MODEL=gemini-3.7-flash

# وضع رسالة التوعية: template | llm | auto
#   template = القوالب الجاهزة (بدون إنترنت)
#   llm      = صياغة الـ LLM مع رجوع تلقائي للقالب عند أي فشل
#   auto     = مثل llm إذا المفتاح موجود، وإلا template
COACH_MODE=template
